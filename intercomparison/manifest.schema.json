{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "climate_indices_intercomparison_manifest_v1",
  "title": "Intercomparison study manifest",
  "description": "What one study ran, on which inputs, with which comparator at which version and effective method. The provenance fields (source, url, download_date, subset_description, checksum_sha256, fixture_version, license, notes) are those of tests/fixture/provenance_schema.json (REFIMPL-08, issue 1610).",
  "type": "object",
  "required": ["schema_version", "study", "created", "harness", "source", "url", "download_date", "subset_description", "checksum_sha256", "fixture_version", "index", "unit", "positions", "inputs", "store", "arrays"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "study": {"type": "string", "minLength": 1},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "harness": {
      "type": "object",
      "required": ["git_commit", "git_dirty"],
      "additionalProperties": false,
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "git_dirty": {"type": "boolean"}
      }
    },
    "source": {"type": "string"},
    "url": {"type": "string"},
    "download_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "subset_description": {"type": "string"},
    "checksum_sha256": {"$ref": "#/$defs/sha256", "description": "SHA-256 of the input series file the comparators read."},
    "fixture_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "license": {"type": "string"},
    "notes": {"type": "string"},
    "index": {"type": "string"},
    "unit": {"type": "string", "description": "The location the series belongs to."},
    "positions": {"type": "object", "minProperties": 1, "description": "The method positions the study asked every comparator to apply."},
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["source_path", "source_sha256", "sha256", "units", "length", "first", "last"],
        "additionalProperties": false,
        "properties": {
          "source_path": {"type": "string"},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "units": {"type": "string"},
          "length": {"type": "integer", "minimum": 1},
          "first": {"type": "string"},
          "last": {"type": "string"}
        }
      }
    },
    "store": {
      "type": "object",
      "required": ["path", "array", "dims", "shape"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "array": {"type": "string"},
        "dims": {"const": ["implementation", "unit", "time"]},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 3, "maxItems": 3}
      }
    },
    "arrays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["implementation", "comparator", "version", "effective_method", "software", "platform", "wall_time_s", "warnings", "output_sha256", "store_index"],
        "additionalProperties": false,
        "properties": {
          "implementation": {"type": "string"},
          "comparator": {"type": "string"},
          "version": {"type": "string"},
          "effective_method": {"type": "object", "minProperties": 1},
          "software": {"type": "object", "additionalProperties": {"type": "string"}},
          "platform": {"type": "string"},
          "wall_time_s": {"type": "number", "minimum": 0},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "output_sha256": {"$ref": "#/$defs/sha256", "description": "SHA-256 of the comparator's output series file."},
          "store_index": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
